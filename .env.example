# ==============================================================================
# Bina AI — Environment Configuration Template
# Copy to .env and fill secrets locally. NEVER commit .env with real keys.
# ==============================================================================

# Application & Runtime (Locked Iran Persian-First Launch Defaults — ADR-023, ADR-035)
# Single source of truth for rebrandable product display names across apps, SMS, PDFs & APIs
APP_BRAND_NAME_FA=بینا
APP_BRAND_NAME_EN=Bina AI
VITE_APP_BRAND_NAME_FA=بینا
VITE_APP_BRAND_NAME_EN=Bina AI
VITE_API_MODE=live
VITE_API_BASE_URL=
STAFF_WEB_HOST_PORT=8088
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DEFAULT_JURISDICTION=IR
DATA_RESIDENCY_REGION=IR
DEFAULT_LOCALE=fa-IR
DEFAULT_CALENDAR=jalali
DEFAULT_COUNTRY_CODE=+98
SELF_HOST_WEB_ASSETS=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8088,http://127.0.0.1:8088

# PostgreSQL (FORCE RLS-enforced; host port 15432 avoids collision with host Postgres)
POSTGRES_HOST_PORT=15432
DATABASE_URL=postgresql://bina_app:bina_app_dev@127.0.0.1:15432/bina_dev
DATABASE_ADMIN_URL=postgresql://bina:bina_dev@127.0.0.1:15432/bina_dev

# Redis (Cache, Rate Limiting & Async AI Inference Queue) & Temporal
REDIS_HOST_PORT=16379
REDIS_URL=redis://127.0.0.1:16379
TEMPORAL_HOST_PORT=17233
TEMPORAL_ADDRESS=127.0.0.1:17233
TEMPORAL_NAMESPACE=default

# Encrypted Object Storage (MinIO / S3-compatible: DICOM, Images, Masks, PDFs)
MINIO_API_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001
S3_ENDPOINT=http://127.0.0.1:19000
S3_BUCKET=bina-evidence-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ==============================================================================
# Pillar 2 Simple Pluggable AI Engine (apps/ai-engine — ADR-050, ADR-051)
# AI_ENGINE_MODE:
#   - cpu_stub  : Default on low-RAM/low-disk dev host (deterministic fixtures, zero GPU/heavy weights)
#   - onnx_cpu  : Lightweight ONNX CPU inference (Router/QC/Tabular XGBoost/Fusion)
#   - gpu_full  : Full vision/OCT/segmentation inference on dedicated GPU server
# FOUNDATION_BACKBONE:
#   - dinov2_apache2          : Commercial-safe Apache 2.0 default (ADR-051)
#   - retfound_research_only  : Non-commercial research/licensed mode only
# ==============================================================================
BACKEND_HOST_PORT=3000
PRISM_HOST_PORT=4010
AI_ENGINE_HOST_PORT=18000
AI_ENGINE_URL=http://127.0.0.1:18000
AI_ENGINE_MODE=cpu_stub
FOUNDATION_BACKBONE=dinov2_apache2
DICOM_ANONYMIZATION_SALT=change_me_dev_only

# ==============================================================================
# Remote Kaggle GPU Training & ONNX Artifact Gathering (ml/ — ADR-047)
# Authenticate CLI via ~/.kaggle/access_token (or set KAGGLE_API_TOKEN locally).
# NEVER upload un-anonymized PHI or raw DICOM 0010,* tags to Kaggle.
# ==============================================================================
KAGGLE_USERNAME=
KAGGLE_ACCELERATOR=nvidiaTeslaT4
ML_ARTIFACTS_DIR=./ml/registry/artifacts

# ==============================================================================
# Switchable OpenAI-Compatible Small-LLM Gateway (ADR-046)
# Current target: OpenRouter small model (thinkingmachines/inkling-2-mini).
# To deploy locally inside Iran (vLLM / Ollama / llama.cpp / SGLang),
# ONLY change LLM_BASE_URL, LLM_MODEL, and LLM_API_KEY — zero code changes.
# ==============================================================================
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=thinkingmachines/inkling-2-mini
LLM_API_KEY=
LLM_TIMEOUT_MS=30000
LLM_MAX_TOKENS=3072
LLM_TEMPERATURE=0.1
LLM_REQUIRE_PHI_SCRUBBING=true
LLM_OPENROUTER_SITE_URL=https://binaai.local
LLM_OPENROUTER_APP_NAME=BinaAI-Dev
