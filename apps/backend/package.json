    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.0",
    "@types/pg": "^8.11.11",
    "typescript": "^5.8.2",
    "vazirmatn": "^33.0.3",
    "vitest": "^3.0.8"
  }
