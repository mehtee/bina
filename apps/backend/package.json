{
  "name": "@bina/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/apps/api/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
