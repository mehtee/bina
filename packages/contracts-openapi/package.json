{
  "name": "@bina/contracts-openapi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./api": {
      "types": "./generated/ts/api.d.ts"
    }
  },
  "scripts": {
    "lint": "node scripts/lint-openapi.mjs && redocly lint openapi.yaml",
    "generate:ts": "openapi-typescript openapi.yaml -o generated/ts/api.d.ts",
    "generate:py-dart": "node scripts/generate-py-dart-dtos.mjs",
    "generate": "pnpm run generate:ts && pnpm run generate:py-dart",
    "mock": "prism mock openapi.yaml --host 127.0.0.1 --port ${PRISM_HOST_PORT:-4010}"
  },
  "devDependencies": {
    "@redocly/cli": "^1.34.5",
    "@stoplight/prism-cli": "^5.14.2",
    "openapi-typescript": "^7.6.1",
    "yaml": "^2.7.0"
  }
}
