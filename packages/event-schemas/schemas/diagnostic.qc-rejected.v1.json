{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bina.ir/schemas/events/diagnostic.qc-rejected.v1.json",
  "title": "DiagnosticQcRejectedV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["studyId", "jobId", "assetId", "rejectionCodes", "rejectionReasonsFa"],
  "properties": {
    "studyId": { "type": "string", "format": "uuid" },
    "jobId": { "type": "string", "format": "uuid" },
    "assetId": { "type": "string", "format": "uuid" },
    "rejectionCodes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["blur", "lighting", "wrong_eye", "modality_mismatch"] }
    },
    "rejectionReasonsFa": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2 }
    }
  }
}
